[Unit]
Description=CorpMS queue worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/corpms/current
ExecStart=/usr/bin/php artisan queue:work --tries=3 --backoff=5 --sleep=3
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
