APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# В production APP_DEBUG игнорируется (гард в config/app.php):
# debug не включается при APP_ENV=production даже если задан true.
APP_URL=http://localhost:8000
# В production APP_URL обязан быть https://<your-domain> (иначе редиректы/ссылки будут http).

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# APP_PREVIOUS_KEYS=                 # старые APP_KEY через запятую при ротации ключа

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                # ротация логов: daily + LOG_DAILY_DAYS, файлы не растут бесконечно
LOG_DAILY_DAYS=14              # хранить 14 дней логов
# LOG_SYSLOG_IDENT=corpms
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info                 # debug пишет контекст запросов; ПДн/секреты вырезаются redaction-processor

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# prod: true (только HTTPS). Для http-локалки переопределите false в своём .env.
SESSION_SECURE_COOKIE=true

# Reverse proxy: только доверенные IP/CIDR могут задавать X-Forwarded-For/Proto.
# Никогда не используйте "*" в production.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Резервное копирование БД (команда db:backup, ежедневно в 03:30 по расписанию)
# BACKUP_PATH=/var/backups/corpms   # вне public/ — веб-доступа к ПДн нет

# Google OAuth (вход через Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_ALLOWED_DOMAIN=company.tld   # опционально: только аккаунты корпоративного домена
# BACKUP_KEEP=14                    # хранить 14 последних копий
# DB_DUMP_BINARY=mysqldump          # путь к mysqldump, если его нет в PATH

CACHE_STORE=database
# Redis (опционально): при наличии сервера Redis можно переключить
# CACHE_STORE=redis и QUEUE_CONNECTION=redis — драйвер phpredis настроен ниже.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (включить только с BROADCAST_CONNECTION=reverb)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=8080
# REVERB_SCHEME=https

# Telegram-уведомления (если включены)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=  # только заголовок X-Telegram-Bot-Api-Secret-Token, не часть URL
# TELEGRAM_BOT_USERNAME=

# AI-модуль (если включён)
# AI_BASE_URL=
# AI_ALLOWED_HOSTS=                # whitelist хостов LLM через запятую; IP/private networks запрещены
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_IMAGE_MODEL=
# AI_EMBEDDINGS_MODEL=text-embedding-3-small
# AI_RAG_MAX_FILE_BYTES=20971520
# AI_RAG_MAX_EXTRACT_CHARS=500000
# OCR для скан-PDF и изображений (нужны tesseract и pdftoppm из poppler)
# AI_RAG_TESSERACT_PATH=
# AI_RAG_PDFTOPPM_PATH=
# AI_RAG_OCR_LANG=eng+rus
# AI_RAG_OCR_DPI=200
# AI_RAG_OCR_PSM=6
# AI_RAG_OCR_MAX_PAGES=10
# AI_RAG_OCR_TIMEOUT=120
# AI_TIMEOUT=15
# AI_SYNC_TIMEOUT=8
# AI_TOOLS=false

# Laravel Boost: только local. В production не включать (SEC-04).
# BOOST_ENABLED=false
# BOOST_BROWSER_LOGS_WATCHER=false
# BOOST_BROWSER_LOGS_ALLOWED_IPS=127.0.0.1,::1

# Доменные лимиты CorpMS (опционально)
# CORPMS_BIO_REQUIRE_LIVENESS=true
# CORPMS_BIO_OFFLINE_MINUTES=15
# CORPMS_BIO_RAW_TTL_DAYS=30          # SEC-09: срок хранения raw_payload биометрии
# CORPMS_TASKS_MAX_SUBTASK_DEPTH=3
# CORPMS_ONBOARDING_DOC_CATEGORY=onboarding
# CORPMS_DOC_MAX_FILE_MB=25
# CORPMS_SIG_OTP_TTL=5
# CORPMS_SIG_QR_TTL=24
# CORPMS_NOTIFY_SUMMARY_HOUR=8

# LMS / WebRTC (если включены соответствующие модули)
# LMS_POLL_MS=5000
# LMS_STUN_SERVER=
# LMS_TURN_URL=
# LMS_TURN_USERNAME=
# LMS_TURN_CREDENTIAL=

# Очередь / сессия (опционально)
# QUEUE_FAILED_DRIVER=database-uuids
# SESSION_STORE=database
